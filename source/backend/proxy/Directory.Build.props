<Project>
    <!-- This imports global tools (Sonar, StyleCop, CodeStyle) cleanly from the root -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <AnalysisMode>Minimum</AnalysisMode>
        <WarningLevel>4</WarningLevel>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>
    
    <!-- All duplicate ItemGroups containing Sonar, StyleCop, and CodeStyle have been removed -->
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)\..\.editorconfig" />
    </ItemGroup>
</Project>
